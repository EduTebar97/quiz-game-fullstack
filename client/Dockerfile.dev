FROM node:20-alpine

# Instalar dependencias necesarias para compilar paquetes nativos
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copiar archivos de configuración para aprovechar la caché
COPY package*.json .
COPY tsconfig.json .
COPY vite.config.ts .
COPY .eslintrc.* .
COPY .prettierrc.* .

# Instalar dependencias con mayor nivel de logs para debuggear
RUN npm install --verbose

# Configurar variables de entorno para desarrollo
ENV NODE_ENV=development
ENV VITE_API_URL=http://backend:8080
ENV VITE_WEBSOCKET_URL=ws://backend:8080

# Copiar el resto del código
COPY . .

# Exponer puerto
EXPOSE 3000

# Usar el comando de desarrollo con host y permitir hot reload
CMD ["npm", "run", "dev", "--", "--host", "--strictPort"]